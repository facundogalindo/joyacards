export function shuffleArray(array) {
  return [...array].sort(() => Math.random() - 0.5);
}

export function areAnswersCorrect(selectedAnswers, correctAnswers) {
  if (selectedAnswers.length !== correctAnswers.length) {
    return false;
  }

  return selectedAnswers.every((answer) => correctAnswers.includes(answer));
}

export function areMultiDropdownAnswersCorrect(items, userAnswers) {
  return items.every((item) => {
    return userAnswers[item.id] === item.answer;
  });
}

export function formatTime(totalSeconds) {
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;

  return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(
    2,
    "0"
  )}`;
}

const OPTION_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

function shuffleNormalQuestionOptions(question) {
  if (!question.options || !question.answers) {
    return question;
  }

  const correctTexts = question.options
    .filter((option) => question.answers.includes(option.letter))
    .map((option) => option.text);

  const shuffledOptions = shuffleArray(question.options);

  const newOptions = [];
  const newAnswers = [];

  shuffledOptions.forEach((option, index) => {
    const newLetter = OPTION_LETTERS[index];

    newOptions.push({
      letter: newLetter,
      text: option.text
    });

    if (correctTexts.includes(option.text)) {
      newAnswers.push(newLetter);
    }
  });

  return {
    ...question,
    options: newOptions,
    answers: newAnswers
  };
}

function shuffleMultiDropdownOptions(question) {
  if (!question.items) {
    return question;
  }

  return {
    ...question,
    items: question.items.map((item) => ({
      ...item,
      options: shuffleArray(item.options)
    }))
  };
}

export function prepareQuizQuestions(questions, amount) {
  return shuffleArray(questions)
    .slice(0, amount)
    .map((question) => {
      if (question.type === "multi_dropdown") {
        return shuffleMultiDropdownOptions(question);
      }

      if (
        question.type === "single_choice" ||
        question.type === "multiple_choice" ||
        question.type === "true_false"
      ) {
        return shuffleNormalQuestionOptions(question);
      }

      return question;
    });
}